FROM golang:1.27-alpine AS builder

WORKDIR /app
COPY go.work go.mod go.sum ./
COPY fileserver/go.* ./fileserver/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/jobworker.bin ./cmd/jobworker

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/jobworker.bin /app/jobworker.bin

ENTRYPOINT ["/app/jobworker.bin"]
