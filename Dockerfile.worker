FROM golang:1.27-alpine AS builder

WORKDIR /app
COPY go.work go.mod go.sum ./
COPY shared/authkit/go.* ./shared/authkit/
COPY fileserver/go.* ./fileserver/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/worker ./cmd/worker

FROM alpine:latest
# Install filesystem tools required for loop-mounted sparse volumes
RUN apk --no-cache add ca-certificates tzdata e2fsprogs util-linux docker-cli

WORKDIR /app
COPY --from=builder /app/worker /app/worker

EXPOSE 9090
# Requires container execution with --cap-add=SYS_ADMIN and device loop access
ENTRYPOINT ["/app/worker"]
