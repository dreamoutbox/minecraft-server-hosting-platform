# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
BILLING_PROVIDER=
FORWARD_TO=http://host.docker.internal:8080/api/v1/billing/webhook

# Images
APISERVER_IMAGE=dreamoutbox/minecraft-hosting-apiserver:latest
WORKER_IMAGE=dreamoutbox/minecraft-hosting-worker:latest
FILESERVER_IMAGE=dreamoutbox/minecraft-hosting-fileserver:latest
JOBWORKER_IMAGE=dreamoutbox/minecraft-hosting-jobworker:latest

# API Server
PORT=8080
APP_BASE_URL=http://localhost:8080
JWT_SECRET=dev-platform-jwt-secret-key-change-in-prod
RETENTION_DAYS=7
PORT_RANGE_MIN=25565
PORT_RANGE_MAX=25600

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=minecraft_hosting
PGDATA=/var/lib/postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=minecraft_hosting
DB_SSLMODE=disable
ADMINER_DEFAULT_SERVER=postgres

# Storage (S3 / SeaweedFS)
STORAGE_TYPE=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=minecraft-backups
S3_USE_PATH_STYLE=true

# Worker
WORKER_PORT=9090
WORKER_API_KEY=dev-worker-key
WORKER_BASE_DIR=/var/lib/mc-platform
WORKER_MAX_SERVERS=20
WORKER_LOOP_DEVICE_ENABLED=true
DEFAULT_WORKER_URL=http://worker:9090
DEFAULT_WORKER_KEY=dev-worker-key
DEFAULT_WORKER_NAME=worker1
DEFAULT_WORKER_PUBLIC_DOMAIN=localhost
DEFAULT_WORKER_PUBLIC_IP=127.0.0.1

# File Server
FILESERVER_PORT=9100
FILESERVER_SQLITE_PATH=/data/fileserver.db
FILESERVER_MOUNTS_DIR=/var/lib/mc-platform/mounts
FILESERVER_API_KEY=dev-worker-key
FILESERVER_JWT_SECRET=dev-fileserver-jwt-secret-change-in-prod
FILESERVER_MAX_UPLOAD_MB=2048
FILESERVER_DAILY_QUOTA_MB=5120
DEFAULT_FILESERVER_URL=http://localhost:9100
DEFAULT_FILESERVER_INTERNAL_URL=http://fileserver:9100
